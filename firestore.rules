rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && myUser().data.role == "ADMINISTRADOR";
    }

    function isPastor() {
      return signedIn() && myUser().data.role == "PASTOR";
    }

    function isSecretary() {
      return signedIn() && myUser().data.role == "SECRETARIA";
    }

    function isLeader() {
      return signedIn() && myUser().data.role == "LIDER";
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin() || isPastor());
      allow create, update, delete: if isAdmin();
    }

    match /pessoas/{personId} {
      allow read: if signedIn() && (isAdmin() || isPastor() || isSecretary() || isLeader());
      allow create, update: if isAdmin() || isPastor() || isSecretary();
      allow delete: if isAdmin();
    }

    match /pessoas/{personId}/history/{entryId} {
      allow read: if signedIn() && (isAdmin() || isPastor() || isSecretary());
      allow create: if isAdmin() || isPastor() || isSecretary();
      allow update, delete: if isAdmin();
    }

    match /visits/{visitId} {
      allow read: if signedIn() && (isAdmin() || isPastor() || isSecretary() || isLeader());
      allow create: if signedIn();
      allow update: if isAdmin() || isPastor() || isSecretary() || isLeader();
      allow delete: if isAdmin();
    }
  }
}
